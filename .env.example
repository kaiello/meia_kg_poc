# MEIA Knowledge Graph POC - Environment Configuration

# Primary LLM: DeepSeek
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Alternative LLM: Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-2.0-flash

# Custom / OpenAI Compatible / Ollama
CUSTOM_API_KEY=your_custom_key_here
CUSTOM_BASE_URL=https://api.openai.com/v1
CUSTOM_MODEL=gpt-4o-mini

# Default Engine: deepseek | deterministic | gemini | custom
DEFAULT_ENGINE=deepseek

# Embeddings & Reranking
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
