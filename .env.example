# MEIA Knowledge Graph POC - Environment Configuration
# Default: 100% Local Open-Weight Stack on RTX 3080 Ti (16 GB VRAM)

# Primary Local LLM / VLM: Ollama (Zero-Cloud Open-Weight Default)
DEFAULT_ENGINE=ollama:qwen3-vl:8b-instruct
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_NATIVE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=qwen3-vl:8b-instruct

# Local Embeddings & Cross-Encoder Reranking (Cached in ~/.cache/huggingface/hub)
EMBEDDING_MODEL_NAME=BAAI/bge-large-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
VISUAL_RETRIEVER_MODEL=vidore/colqwen2.5-v0.2
DOCLING_MODEL=ibm/granite-docling:258m

# Optional Cloud LLMs (Fallback)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-2.0-flash

# Custom / OpenAI-Compatible / Alternative Loopback
CUSTOM_API_KEY=your_custom_key_here
CUSTOM_BASE_URL=https://api.openai.com/v1
CUSTOM_MODEL=gpt-4o-mini

