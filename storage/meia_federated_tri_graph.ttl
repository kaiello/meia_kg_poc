meia_data:tech_jop_ghostfin_uuv a bfo:InformationContentEntity ;
    rdfs:label "Operational Problem: Ghostfin: Long-Range, Hybrid Electr" ;
    skos:related meia_data:meia_JointOperationalProblem ;
    meia:ADDRESSED_BY_OFFERING meia_data:tech_ghostfin_uuv ;
    meia:description "Ghostfin enhances UUVGRU, SOF dive teams, and Marine Corps stand-in units' capabilities by closing the undersea distance gap and providing long-endurance undersea sensing and effects delivery. With 1,000 nautical miles of range and up to 30 days of endurance, Ghostfin can reach contested waters from standoff positions without relying on scarce submarines, surface ships, or other exquisite manned launch platforms. Its 250 lbs of modular payload capacity enables real operational impact beyond short-range sensing. By combining range, endurance, payload delivery, and affordability, Ghostfin gives these operators an attritable undersea capability that can get to the fight, remain on station, project undersea power from distributed or austere launch points, and reduce risk to high-value assets." ;
    meia:graphDomain "TECH" .

meia_data:tech_jop_tactical_microgrid a bfo:InformationContentEntity ;
    rdfs:label "Operational Problem: Tactical Micro-Grid Hybrid Energy &" ;
    skos:related meia_data:meia_JointOperationalProblem ;
    meia:ADDRESSED_BY_OFFERING meia_data:tech_tactical_microgrid ;
    meia:description "Counter adversary ability to locate and target high value targets." ;
    meia:graphDomain "TECH" .

meia_data:tech_jop_voltvessel_energy a bfo:InformationContentEntity ;
    rdfs:label "Operational Problem: VoltVessel Maritime High-Density En" ;
    skos:related meia_data:meia_JointOperationalProblem ;
    meia:ADDRESSED_BY_OFFERING meia_data:tech_voltvessel_energy ;
    meia:description "Voltage enhances Joint Force capability by shifting critical mission hardware from long supply chains to forward digital production. The Eclipse X9 Expeditionary Manufacturing Cell enables rapid manufacture and repair of rugged composite parts including payload housings, battery compartments, sensor mounts, electronics enclosures, protective shrouds, brackets, and other field-replaceable components for unmanned and expeditionary systems. This improves readiness in contested logistics environments where simple structural or packaging parts can delay operations when resupply is slow or unavailable. Eclipse X9 combines structural performance, low water absorption, corrosion resistance, non-conductive behavior, and repairability, making it well suited for distributed sustainment, modular mission hardware, and localized fabrication that preserves tempo and reduces sustainment burden." ;
    meia:graphDomain "TECH" .

meia_data:tech_klas_voyager a bfo:MaterialEntity ;
    rdfs:label "Klas Voyager Modular Tactical Communications" ;
    skos:related meia_data:meia_C5ISRT,
        meia_data:osra_TacticalCommunications ;
    meia:DEVELOPED_BY meia_data:org_klas_gov ;
    meia:description "Rugged, low-SWaP modular compute and networking platform for tactical edge communications and C5ISR" ;
    meia:graphDomain "TECH" ;
    meia:offering_name "Klas Voyager Modular Tactical Communications" .

